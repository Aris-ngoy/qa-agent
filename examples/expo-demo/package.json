{
  "name": "yoqa-expo-demo",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "prebuild:ios": "expo prebuild --platform ios --non-interactive",
    "prebuild:android": "expo prebuild --platform android --non-interactive",
    "ios:release": "expo run:ios --configuration Release --no-bundler",
    "android:release": "expo run:android --variant release --no-bundler"
  },
  "dependencies": {
    "expo": "~57.0.12",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
