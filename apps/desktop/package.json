{
	"name": "@yoqa/desktop",
	"version": "1.0.3",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite build && concurrently -k -n vite,app -c green,magenta \"vite --port 5173\" \"bun scripts/wait-for-vite.ts && YOQA_REPO_ROOT=$(cd ../.. && pwd) electrobun dev --watch\"",
		"start": "vite build && YOQA_REPO_ROOT=$(cd ../.. && pwd) electrobun dev",
		"build": "vite build && electrobun build --env=canary",
		"build:release": "vite build && electrobun build --env=stable",
		"build:runner": "bun scripts/build-runner-sidecar.ts",
		"icons": "bun scripts/generate-app-icon.ts",
		"check": "tsc --noEmit",
		"e2e": "playwright test"
	},
	"dependencies": {
		"@fontsource/inter": "^5.3.0",
		"@heroui/react": "^3.2.3",
		"@heroui/styles": "^3.2.2",
		"@legendapp/state": "3.0.0-beta.48",
		"@tanstack/react-query": "^5.81.5",
		"@tanstack/react-router": "^1.121.34",
		"@yoqa/runner-client": "workspace:*",
		"@yoqa/ui": "workspace:*",
		"electrobun": "^1.16.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-hook-form": "^7.82.0"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/vite": "^4.1.18",
		"@types/bun": "^1.2.18",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^4.7.0",
		"@yoqa/typescript-config": "workspace:*",
		"babel-plugin-react-compiler": "1.0.0",
		"concurrently": "^9.2.1",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"vite": "^8.2.0"
	}
}
